# Flask secret used to sign JWTs — change this to a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret

# SQLite database path (relative to backend/)
DATABASE_URL=sqlite:///instance/vault.db

# Where uploaded PDFs are stored on disk
UPLOAD_FOLDER=uploads

# Max upload size in bytes (20 MB default)
MAX_CONTENT_LENGTH=20971520

# Anthropic API key — required only for the RAG "ask a question" feature.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used to answer RAG questions
ANTHROPIC_MODEL=claude-sonnet-4-6

# Free alternative to Anthropic: Google Gemini, via Google AI Studio
# (aistudio.google.com/apikey — no credit card required for the free tier).
# Only used if ANTHROPIC_API_KEY above is left blank.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Genuinely free option, no card at all: Groq (console.groq.com/keys).
# Runs open-weight models (Llama, etc.) on fast inference hardware.
# Checked before Gemini if ANTHROPIC_API_KEY is blank.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Cookie security — set to true when serving over HTTPS in production
COOKIE_SECURE=false
